# IRL Stream Platform — copy to .env and replace every CHANGE_ME value.

# APP
PUBLIC_HOST=stream.example.com
CONTROL_API_PORT=8080

# DATABASE (not used before Phase 3)
# DATABASE_URL=

# AUTH
# Generate with: openssl rand -hex 32
PUBLISH_TOKEN=CHANGE_ME_64_HEX_CHARACTERS
READ_TOKEN=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS

# MEDIA
MEDIA_PATH=irl
MEDIA_MAX_READERS=8
MEDIA_MTX_VERSION=1.19.3

# RTMP
RTMP_PORT=1935
RTMPS_PORT=1936
# no, optional or strict. "strict" requires data/tls/tls.crt and tls.key.
RTMP_ENCRYPTION=no

# SRT
SRT_PORT=8890
# SRT requires 10-79 characters. Generate with: openssl rand -hex 24
SRT_READ_PASSPHRASE=CHANGE_ME_SRT_PASSPHRASE
SRT_LATENCY_US=2000000

# HLS
HLS_SEGMENT_COUNT=7

# WEBRTC (not enabled in Phase 1)
# WEBRTC_ADDITIONAL_HOSTS=

# OBS (used from Phase 5)
# OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
# OBS_WEBSOCKET_PASSWORD=

# RECORDING (not enabled in Phase 1)
RECORDING_ENABLED=false
RECORDING_RETENTION_DAYS=14

# MONITORING
METRICS_ENABLED=true

# ALERTS (used from Phase 4)
# ALERT_WEBHOOK_URL=

# STORAGE
BACKUP_DIR=./backups
RECORDING_DIR=./recordings
DISK_WARNING_PERCENT=85

# TLS
TLS_CERT_FILE=/tls/tls.crt
TLS_KEY_FILE=/tls/tls.key

# BACKUP
BACKUP_RETENTION_DAYS=30

# LOGGING
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
